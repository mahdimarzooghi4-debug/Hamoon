HAMOON_ENVIRONMENT=local
HAMOON_DATABASE_URL=postgresql+asyncpg://hamoon:hamoon@localhost:5432/hamoon
HAMOON_NATS_URL=nats://localhost:4222
HAMOON_OTEL_ENABLED=false

HAMOON_OIDC_ISSUER_URL=http://localhost:8081/realms/hamoon-local
HAMOON_OIDC_AUDIENCE=hamoon-api
HAMOON_OIDC_JWKS_URL=
HAMOON_OIDC_CLOCK_SKEW_SECONDS=30

# Local-only infrastructure bootstrap values.
POSTGRES_USER=hamoon
POSTGRES_PASSWORD=hamoon
POSTGRES_DB=hamoon
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345

HAMOON_TEMPORAL_ADDRESS=localhost:7233
HAMOON_TEMPORAL_NAMESPACE=default
HAMOON_TEMPORAL_CORE_TASK_QUEUE=hamoon-core
