HAMOON_ENVIRONMENT=local
HAMOON_DATABASE_URL=postgresql+asyncpg://hamoon:hamoon@localhost:5432/hamoon

# Internal event delivery.
HAMOON_NATS_URL=nats://localhost:4222
HAMOON_NATS_EVENTS_STREAM=HAMOON_EVENTS
HAMOON_OUTBOX_BATCH_SIZE=50
HAMOON_OUTBOX_POLL_SECONDS=1.0
HAMOON_OUTBOX_LEASE_SECONDS=30
HAMOON_OUTBOX_MAX_BACKOFF_SECONDS=300

# Local observability. External OTLP backend is optional/deferred.
HAMOON_OTEL_ENABLED=false
HAMOON_OTEL_SERVICE_NAME=hamoon-api
HAMOON_OTEL_EXPORTER_OTLP_ENDPOINT=
HAMOON_METRICS_ENABLED=true
HAMOON_STRUCTURED_LOGGING=true

# Private local evidence adapter.
HAMOON_EVIDENCE_LOCAL_ROOT=.hamoon/evidence
HAMOON_EVIDENCE_SIGNING_SECRET=hamoon-local-evidence-secret
HAMOON_EVIDENCE_UPLOAD_TTL_SECONDS=300
HAMOON_EVIDENCE_DOWNLOAD_TTL_SECONDS=300
HAMOON_EVIDENCE_MAX_UPLOAD_BYTES=10485760
HAMOON_EVIDENCE_ALLOWED_MEDIA_TYPES=application/pdf,image/jpeg,image/png,text/plain

# Local identity.
HAMOON_OIDC_ISSUER_URL=http://localhost:8081/realms/hamoon-local
HAMOON_OIDC_AUDIENCE=hamoon-api
HAMOON_OIDC_JWKS_URL=
HAMOON_OIDC_CLOCK_SKEW_SECONDS=30

# External AI provider credentials are intentionally optional for local execution.
HAMOON_OPENAI_API_KEY=
HAMOON_OPENAI_BASE_URL=https://api.openai.com/v1
HAMOON_OPENAI_TIMEOUT_SECONDS=60

# Local Temporal orchestration.
HAMOON_TEMPORAL_ADDRESS=localhost:7233
HAMOON_TEMPORAL_NAMESPACE=default
HAMOON_TEMPORAL_CORE_TASK_QUEUE=hamoon-core

# Local-only infrastructure bootstrap values.
POSTGRES_USER=hamoon
POSTGRES_PASSWORD=hamoon
POSTGRES_DB=hamoon
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
